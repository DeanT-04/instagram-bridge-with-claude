# Copy to ~/.heliograph/.env and adjust (a .env in the repo/working dir is ignored for safety).
# HELIOGRAPH_HOME=~/.heliograph
# HELIOGRAPH_BROWSER_PROFILE_DIR=~/.heliograph/browser-profile
# HELIOGRAPH_DOSSIER_DIR=~/.heliograph/dossiers
# HELIOGRAPH_EYE_DIR=~/.heliograph/eye
# HELIOGRAPH_CDP_PORT=0                 # 0 = pick a random free port on 127.0.0.1
# HELIOGRAPH_BROWSER_CHANNEL=auto       # auto | msedge | chrome | chromium
# HELIOGRAPH_BROWSER_IDLE_MINUTES=15    # MCP server closes the browser it opened after N idle minutes (0 = never)
# HELIOGRAPH_WHISPER_MODEL=small
# HELIOGRAPH_READ_MIN_INTERVAL=1.5      # seconds between read operations
# HELIOGRAPH_READ_JITTER=1.0
# HELIOGRAPH_WRITE_MIN_INTERVAL=20
# HELIOGRAPH_WRITE_JITTER=10
# HELIOGRAPH_LOG_LEVEL=INFO

# Optional Langfuse export for the eye (off unless both are set and `langfuse` is installed)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
